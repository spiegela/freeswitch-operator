#!KAMAILIO
#
# Generated by freeswitch-operator for KamailioCluster {{.Name}}. Do not edit: a change to this file rolls the
# Kamailio pods one at a time. Kamailio holds the edge's fixed signaling addresses and spreads new calls over the
# FreeSWITCH fleets in spec.dispatch with the dispatcher module. The dispatcher list is not part of this file: the
# operator keeps it in a mounted ConfigMap and has Kamailio reload it live, over JSON-RPC.
#
# Set per pod by start.sh with -A:
#   PUBLIC_ADDR    the address advertised in Via and Record-Route
#   PRIVATE_ADDR   the pod's own address, the only one JSON-RPC and the metrics listen on
#   BIND_ADDR      only when the pod's address pool gives it an address of its own on the node (a secondary
#                  private address, or the public address itself): peers are served there and FreeSWITCH on
#                  PRIVATE_ADDR, and each request leaves from the side it is going to
#   PRIVATE_NAME   the pod's route name (<pod>.<name>-kamailio-route...), as a quoted string (a label may be a
#                  config keyword, such as "default"): always one of Kamailio's own names, and with BIND_ADDR
#                  advertised on PRIVATE_ADDR in place of the address
#
# Dispatcher sets, in priority order:{{range .Sets}} {{.}}{{else}} none{{end}}
{{- if .TrustedPeers}}
# Trusted peers:{{range .TrustedPeers}} {{.Name}}{{end}}
{{- end}}
{{- if .Capture}}
# SIP capture: HEPv3 to {{.Capture.Address}}, capture ID {{.CaptureID}}
{{- end}}

#!define SIP_PORT {{.SIPPort}}
#!define RPC_PORT {{.RPCPort}}
#!define METRICS_PORT {{.MetricsPort}}
# How long a FreeSWITCH node has to answer anything (it sends 100 Trying to an INVITE at once): after this a new
# call fails over to the next node, and a dispatcher probe counts as failed. It is tm's fr_timer, which the probes
# use (dispatcher has no timeout of its own).
#!define DS_FR_TIMER 5000
# Requests Kamailio relays onward (to a peer, or along a dialog) wait 64*T1, as RFC 3261 sets Timers B and F.
#!define RELAY_FR_TIMER 32000
#!define FR_INV_TIMER 60000
#!define DISPATCHER_LIST "{{.DispatcherList}}"
# A name-addr whose display name, if any, is well formed (RFC 3261 25.1): a quoted string, or words of token
# characters (ASCII only: FreeSWITCH discards an unquoted name with anything else in it, UTF-8 included).
#!define NAME_ADDR "^[ \t]*(\"([^\"\\\\]|\\\\.)*\"[ \t]*|[-A-Za-z0-9.!%*_+`'~ \t]*)<"

debug=2
log_stderror=yes
children=4
tcp_accept_no_cl=yes
# The largest message Kamailio takes in. The default (32767) drops larger datagrams unread; a SIP message may be up
# to 65,535 bytes (a large SDP offer, a long header list), and ETSI TS 102 027-2 checks a proxy relays one that size.
msg_recv_max_size=65535
# The same over TCP: the read buffer one message must fit in (the default overruns well short of that).
tcp_rd_buf_size=65536
auto_aliases=no
#!ifdef PRIVATE_NAME
# Ours whether or not a listener advertises it: a dialog set up while it was advertised routes through it for as
# long as the call lasts, across a restart that came up without the bind address (a single listener).
alias=PRIVATE_NAME:SIP_PORT
#!endif

#!ifdef BIND_ADDR
# Peers on the pool's address, FreeSWITCH on the pod's own. Listening on both (not 0.0.0.0) makes replies leave
# from the address the request came to, and the cloud translates only the pool's.
listen=udp:BIND_ADDR:SIP_PORT advertise PUBLIC_ADDR:SIP_PORT
listen=tcp:BIND_ADDR:SIP_PORT advertise PUBLIC_ADDR:SIP_PORT
#!ifdef PRIVATE_NAME
# FreeSWITCH reaches this pod by its name: a call another node recovers after this one is lost routes back
# through the replacement pod, wherever it runs. The operator keeps the name at the pod's last address while it
# restarts, so in-dialog requests retransmit to it rather than fail on a name that doesn't resolve.
listen=udp:PRIVATE_ADDR:SIP_PORT advertise PRIVATE_NAME:SIP_PORT
listen=tcp:PRIVATE_ADDR:SIP_PORT advertise PRIVATE_NAME:SIP_PORT
#!else
listen=udp:PRIVATE_ADDR:SIP_PORT
listen=tcp:PRIVATE_ADDR:SIP_PORT
#!endif
#!else
listen=udp:0.0.0.0:SIP_PORT advertise PUBLIC_ADDR:SIP_PORT
listen=tcp:0.0.0.0:SIP_PORT advertise PUBLIC_ADDR:SIP_PORT
#!endif
# JSON-RPC for the operator, on the pod's own address only; every request needs the bearer token.
listen=tcp:PRIVATE_ADDR:RPC_PORT
# Prometheus metrics (GET /metrics), on the pod's own address only. Read-only, so no token.
listen=tcp:PRIVATE_ADDR:METRICS_PORT

loadmodule "kex.so"
loadmodule "corex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "dispatcher.so"
loadmodule "htable.so"
loadmodule "xhttp.so"
loadmodule "jsonrpcs.so"
loadmodule "xhttp_prom.so"
{{- if .TrustedPeers}}
loadmodule "ipops.so"
{{- end}}
{{- if .Capture}}
loadmodule "siptrace.so"
{{- end}}

# Set to 1 over JSON-RPC by the pod's drain: new calls from peers then get 503 and go to another Kamailio.
modparam("pv", "shvset", "draining=i:0")

# The list is a ConfigMap mounted as a directory (never with subPath, which does not update). Every destination
# carries flag 8 (probing), and ds_probing_mode 3 keeps probing them without taking any out of rotation until it
# fails: a node that stops answering goes inactive on its own, ahead of the operator's next list.
modparam("dispatcher", "list_file", DISPATCHER_LIST)
modparam("dispatcher", "flags", 2)
modparam("dispatcher", "ds_ping_interval", 10)
modparam("dispatcher", "ds_probing_mode", 3)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 2)
modparam("dispatcher", "ds_ping_reply_codes", "class=2;code=403;code=404;code=405")
modparam("dispatcher", "xavp_dst", "_dsdst_")
# "Is this one of our nodes" is ds_is_from_list("-1", "3"): any set, matched on the address alone (mode 3: port
# and protocol ignored). Without arguments it also matches the port, and a node's request over TCP comes from an
# ephemeral port, not the one the list names.

# FreeSWITCH node addresses the operator admits over JSON-RPC (htable.seti) as soon as it writes a list naming them:
# Kamailio sees the list itself only once the kubelet has updated the mounted file and the operator has reloaded it,
# which takes longer than a SIP transaction lasts. Entries go after 15 minutes, by when the list has them.
modparam("htable", "htable", "admitted=>size=8;autoexpire=900;")

# A failed check answers the request and returns false, rather than ending the script there, so it can be counted.
modparam("sanity", "autodrop", 0)

modparam("rr", "enable_full_lr", 1)
modparam("rr", "append_fromtag", 1)
modparam("tm", "fr_timer", DS_FR_TIMER)
modparam("tm", "fr_inv_timer", FR_INV_TIMER)
# Pass a 503 on as 503 (by default tm turns a final 503 into 500): when every node is full, carriers see the same
# 503 they get when no node is up, and reroute.
modparam("tm", "remap_503_500", 0)

# Kamailio's own statistics (tm, sl, core, ...) as kamailio_* metrics, kept however long they go unchanged, and the
# counters below. A rejected request's source and Call-ID go to the log, not into labels.
#   kamailio_rejected_requests_total{reason}  requests refused before any node saw them: display_name (400 here),
#                                             sanity (sanity's own 4xx), uri_scheme (416){{if .TrustedPeers}}, untrusted_source
#                                             (dropped unanswered: not a trusted peer or one of our nodes){{end}}
#   kamailio_node_silent_timeouts_total       a node didn't answer a request within DS_FR_TIMER
#   kamailio_silent_drops_total{cause}        every node tried stayed silent and the caller got 408: cause request
#                                             when a node answered another call meanwhile (the nodes are up and
#                                             discarded this request, a malformed one most likely), nodes when none
#                                             did (the fleet itself may be down)
modparam("xhttp_prom", "xhttp_prom_stats", "all")
modparam("xhttp_prom", "xhttp_prom_timeout", 0)
modparam("xhttp_prom", "prom_counter", "name=rejected_requests_total; label=reason")
modparam("xhttp_prom", "prom_counter", "name=node_silent_timeouts_total;")
modparam("xhttp_prom", "prom_counter", "name=silent_drops_total; label=cause")
# When a node last answered anything relayed to it (any reply, 100 Trying included), in seconds since the epoch.
modparam("pv", "shvset", "node_answered=i:0")

{{- if .Capture}}
# A HEPv3 copy of every SIP message sent or received (trace_mode 1 mirrors at the network layer, so no route has to
# ask for it), over UDP to spec.capture.address. Copies are never waited on.
modparam("siptrace", "duplicate_uri", "sip:{{.Capture.Address}}")
modparam("siptrace", "hep_mode_on", 1)
modparam("siptrace", "hep_version", 3)
modparam("siptrace", "hep_capture_id", {{.CaptureID}})
modparam("siptrace", "trace_to_database", 0)
modparam("siptrace", "trace_on", 1)
modparam("siptrace", "trace_mode", 1)

{{end -}}
modparam("jsonrpcs", "pretty_format", 1)
# HTTP only (via xhttp). The default leaves HTTP off, and jsonrpc_dispatch() then drops each request unanswered.
modparam("jsonrpcs", "transport", 1)

request_route {
{{- if .TrustedPeers}}
	# Only trusted peers (spec.trustedPeers) and our own nodes get anything from us, an error included: a request
	# from anywhere else is dropped before it is parsed further, so scanners learn nothing. In-dialog requests are
	# checked too, so a forged Route set can't make Kamailio relay for a stranger. Our own nodes are the dispatcher
	# list's, and those the operator has admitted ahead of it (a node a pod has just moved to, with calls).
	if (!ds_is_from_list("-1", "3") && $sht(admitted=>$si) == $null && !route(TRUSTED_PEER)) {
		prom_counter_inc("rejected_requests_total", "1", "untrusted_source");
		xlog("L_INFO", "dropped $rm from untrusted $si:$sp\n");
		exit;
	}
{{- end}}
	# Adds Max-Forwards: 70 when missing (RFC 3261's recommended value), decrements it otherwise.
	if (!mf_process_maxfwd_header("70")) {
		sl_send_reply("483", "Too Many Hops");
		exit;
	}
	# RFC 3261 8.2.2.1: a Request-URI scheme we don't support (anything but sip, sips and tel) gets 416. Matched on
	# the request line itself: a URI Kamailio can't parse has no $ru, and sanity would answer 400 Bad Request URI.
	# The method is any token (RFC 3261 25.1: % and the like included), and a Request-URI that doesn't start with a
	# scheme at all (one in <>, say) isn't an unsupported scheme: sanity answers it 400 instead.
	if ($(mb{line.at,0}) =~ "^[^ ]+ +[A-Za-z][A-Za-z0-9+.-]*:" && !($(mb{line.at,0}) =~ "^[^ ]+ +(sips?|tel):")) {
		prom_counter_inc("rejected_requests_total", "1", "uri_scheme");
		sl_send_reply("416", "Unsupported URI Scheme");
		exit;
	}
	# 18407 adds the Proxy-Require check (512) to the module's default checks: a request requiring an extension
	# we don't support gets 420 (sanity's proxy_require list is empty).
	if (!sanity_check("18407", "7")) {
		prom_counter_inc("rejected_requests_total", "1", "sanity");
		exit;
	}

	# Requests inside a dialog follow its route set, draining or not.
	if (has_totag()) {
		if (loose_route()) {
			t_set_fr(FR_INV_TIMER, RELAY_FR_TIMER);
			route(RELAY);
		}
		if (is_method("ACK")) {
			if (t_check_trans()) {
				route(RELAY);
			}
			exit;  # an ACK is never answered
		}
		sl_send_reply("481", "Call/Transaction Does Not Exist");
		exit;
	}

	# A CANCEL follows its INVITE to the node that has it. One that matches nothing is answered, not forwarded:
	# without the INVITE there is no node to send it to.
	if (is_method("CANCEL")) {
		if (t_check_trans()) {
			route(RELAY);
		}
		sl_send_reply("481", "Call/Transaction Does Not Exist");
		exit;
	}
	if (t_precheck_trans()) {
		t_check_trans();
		exit;
	}
	t_check_trans();

	# Keepalives: OPTIONS with no user part, from anyone but our own nodes (theirs go on to the peer they ping).
	# Matched on the missing user rather than on our address, which a peer may write as a name or an address
	# Kamailio doesn't know as its own. While draining, or while no node is active, the answer is 503, so peers
	# route elsewhere.
	if (is_method("OPTIONS") && $rU == $null && !ds_is_from_list("-1", "3")) {
		if ($shv(draining) == 1 || !route(ANY_ACTIVE)) {
			sl_send_reply("503", "No FreeSWITCH Available");
			exit;
		}
		append_to_reply("Allow: INVITE, ACK, BYE, CANCEL, OPTIONS, INFO, UPDATE, REFER, NOTIFY\r\n");
		sl_send_reply("200", "OK");
		exit;
	}

	remove_hf("Route");
	record_route();

	# From a FreeSWITCH node toward a peer: relay to the request URI, from our fixed address. A draining Kamailio
	# still relays these: they belong to calls already up (a transfer, say).
	if (ds_is_from_list("-1", "3")) {
		t_set_fr(FR_INV_TIMER, RELAY_FR_TIMER);
		route(TO_PEERS);
		route(RELAY);
	}

	if ($shv(draining) == 1) {
		sl_send_reply("503", "Draining");
		exit;
	}

	# FreeSWITCH discards a request whose From or To it can't parse without answering, so every node in turn would
	# stay silent on it while the caller waits for 408. Refuse those here instead.
	if (!route(DISPLAY_NAMES)) {
		prom_counter_inc("rejected_requests_total", "1", "display_name");
		xlog("L_WARN", "refused $rm from $si:$sp with a malformed display name (Call-ID $ci)\n");
		sl_send_reply("400", "Malformed Display Name");
		exit;
	}
{{- if .Sets}}

	# From a peer: the first set with an active node, round-robin within it, failing over on 503 or no answer to
	# the set's next node and then to the next set's.
	if (!ds_select_routes("{{.Rules}}", "0")) {
		sl_send_reply("503", "No FreeSWITCH Available");
		exit;
	}
	t_set_fr(FR_INV_TIMER, DS_FR_TIMER);
	$avp(arrived) = $TV(s);
	t_on_reply("NODE_REPLY");
	t_on_failure("DS_FAILOVER");
	route(TO_NODES);
	route(RELAY);
{{- else}}

	# No FreeSWITCH fleet to send calls to (spec.dispatch is empty).
	sl_send_reply("503", "No FreeSWITCH Available");
	exit;
{{- end}}
}

# Whether any set has an active node.
route[ANY_ACTIVE] {
{{- range .Sets}}
	if (ds_is_active("{{.}}")) {
		return 1;
	}
{{- end}}
	return -1;
}

{{if .TrustedPeers}}# Whether the request's source is in spec.trustedPeers.
route[TRUSTED_PEER] {
{{- range .TrustedPeers}}
	# {{.Name}}
	if (is_in_subnet("$si", "{{.Subnets}}")) {
		return 1;
	}
{{- end}}
	return -1;
}

{{end}}# Whether From and To are well formed where Kamailio's parser is lenient and FreeSWITCH's isn't: a display name
# (NAME_ADDR), or, for a bare addr-spec, no comma or question mark (RFC 3261 20: a URI with either must be in <>).
route[DISPLAY_NAMES] {
	if ($hdr(From) =~ "<") {
		if (!($hdr(From) =~ NAME_ADDR)) {
			return -1;
		}
	} else if ($hdr(From) =~ "[,?]") {
		return -1;
	}
	if ($hdr(To) =~ "<") {
		if (!($hdr(To) =~ NAME_ADDR)) {
			return -1;
		}
	} else if ($hdr(To) =~ "[,?]") {
		return -1;
	}
	return 1;
}

# With two listeners, a new request goes out from the side it is going to: toward a node from the pod's own address,
# toward a peer from the pool's. (Requests in a dialog follow the two Record-Routes this leaves, and CANCELs and ACKs
# their transaction, without help.) force_send_socket finds the TCP listener on the same address for a TCP hop.
route[TO_NODES] {
#!ifdef BIND_ADDR
	force_send_socket(udp:PRIVATE_ADDR:SIP_PORT);
#!endif
	return;
}

route[TO_PEERS] {
#!ifdef BIND_ADDR
	force_send_socket(udp:BIND_ADDR:SIP_PORT);
#!endif
	return;
}

route[RELAY] {
	if (!t_relay()) {
		sl_reply_error();
	}
	exit;
}

onreply_route[NODE_REPLY] {
	$shv(node_answered) = $TV(s);
}

# A paused (draining) FreeSWITCH answers new calls with 503; a dead one doesn't answer. Either way, try the next.
# Only a 503 takes the node out of rotation here. A node also stays silent when it discards a request it can't
# parse, so a timeout says something about the request as much as the node: marking on it would let one malformed
# INVITE, silently dropped by every node in turn, take the whole fleet out of rotation. The dispatcher's probes
# (every 10 s, two misses) take a node that has really stopped answering out instead.
failure_route[DS_FAILOVER] {
	if (t_is_canceled()) {
		exit;
	}
	if (t_check_status("503")) {
		ds_mark_dst("ip");
	}
	if (t_branch_timeout() && !t_branch_replied()) {
		prom_counter_inc("node_silent_timeouts_total", "1");
	}
	if (t_check_status("503") || (t_branch_timeout() && !t_branch_replied())) {
		if (ds_next_dst()) {
			t_on_reply("NODE_REPLY");
			t_on_failure("DS_FAILOVER");
			route(TO_NODES);
			route(RELAY);
		}
		if (t_branch_timeout() && !t_branch_replied()) {
			route(SILENT_DROP);
		}
	}
}

# The last node tried stayed silent and there is no other: the caller gets 408. If a node has answered anything
# since this request arrived, the nodes are up and discarded it, the signature of a request they can't parse.
route[SILENT_DROP] {
	if ($shv(node_answered) > $avp(arrived)) {
		prom_counter_inc("silent_drops_total", "1", "request");
		xlog("L_WARN", "every FreeSWITCH node stayed silent on $rm from $si:$sp while answering others (Call-ID $ci)\n");
	} else {
		prom_counter_inc("silent_drops_total", "1", "nodes");
		xlog("L_WARN", "no FreeSWITCH node answered $rm from $si:$sp, or anything else since it arrived (Call-ID $ci)\n");
	}
}

# Metrics on the metrics port; JSON-RPC only on the RPC port and only with the pod's token. A pod without a token
# refuses every RPC.
event_route[xhttp:request] {
	if ($Rp == METRICS_PORT) {
		if (prom_check_uri()) {
			prom_dispatch();
			exit;
		}
		xhttp_reply("404", "Not Found", "text/plain", "not found\n");
		exit;
	}
	# HTTP to any other port (the public SIP port over TCP) gets no answer, as an untrusted SIP source gets none.
	if ($Rp != RPC_PORT) {
		exit;
	}
	$var(bearer) = "Bearer " + $env(KAMAILIO_RPC_TOKEN);
	if ($env(KAMAILIO_RPC_TOKEN) == $null || $env(KAMAILIO_RPC_TOKEN) == "" || $hdr(Authorization) != $var(bearer)) {
		xhttp_reply("401", "Unauthorized", "text/plain", "unauthorized\n");
		exit;
	}
	if ($hu =~ "^/RPC") {
		jsonrpc_dispatch();
		exit;
	}
	xhttp_reply("404", "Not Found", "text/plain", "not found\n");
}
