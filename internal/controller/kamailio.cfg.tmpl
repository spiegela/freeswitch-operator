#!KAMAILIO
#
# Generated by freeswitch-operator for KamailioCluster {{.Name}}. Do not edit: a change to this file rolls the
# Kamailio pods one at a time. Kamailio holds the edge's fixed signaling addresses and spreads new calls over the
# FreeSWITCH fleets in spec.dispatch with the dispatcher module. The dispatcher list is not part of this file: the
# operator keeps it in a mounted ConfigMap and has Kamailio reload it live, over JSON-RPC.
#
# Set per pod by start.sh with -A:
#   PUBLIC_ADDR    the address advertised in Via and Record-Route
#   PRIVATE_ADDR   the pod's own address, the only one JSON-RPC listens on
#
# Dispatcher sets, in priority order:{{range .Sets}} {{.}}{{else}} none{{end}}

#!define SIP_PORT {{.SIPPort}}
#!define RPC_PORT {{.RPCPort}}
# How long a FreeSWITCH node has to answer anything (it sends 100 Trying to an INVITE at once): after this a new
# call fails over to the next node, and a dispatcher probe counts as failed. It is tm's fr_timer, which the probes
# use (dispatcher has no timeout of its own).
#!define DS_FR_TIMER 5000
# Requests Kamailio relays onward (to a peer, or along a dialog) wait 64*T1, as RFC 3261 sets Timers B and F.
#!define RELAY_FR_TIMER 32000
#!define FR_INV_TIMER 60000
#!define DISPATCHER_LIST "{{.DispatcherList}}"

debug=2
log_stderror=yes
children=4
tcp_accept_no_cl=yes
auto_aliases=no

listen=udp:0.0.0.0:SIP_PORT advertise PUBLIC_ADDR:SIP_PORT
listen=tcp:0.0.0.0:SIP_PORT advertise PUBLIC_ADDR:SIP_PORT
# JSON-RPC for the operator, on the pod's own address only; every request needs the bearer token.
listen=tcp:PRIVATE_ADDR:RPC_PORT

loadmodule "kex.so"
loadmodule "corex.so"
loadmodule "tm.so"
loadmodule "tmx.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "dispatcher.so"
loadmodule "xhttp.so"
loadmodule "jsonrpcs.so"

# Set to 1 over JSON-RPC by the pod's drain: new calls from peers then get 503 and go to another Kamailio.
modparam("pv", "shvset", "draining=i:0")

# The list is a ConfigMap mounted as a directory (never with subPath, which does not update). Every destination
# carries flag 8 (probing), and ds_probing_mode 3 keeps probing them without taking any out of rotation until it
# fails: a node that stops answering goes inactive on its own, ahead of the operator's next list.
modparam("dispatcher", "list_file", DISPATCHER_LIST)
modparam("dispatcher", "flags", 2)
modparam("dispatcher", "ds_ping_interval", 10)
modparam("dispatcher", "ds_probing_mode", 3)
modparam("dispatcher", "ds_probing_threshold", 2)
modparam("dispatcher", "ds_inactive_threshold", 2)
modparam("dispatcher", "ds_ping_reply_codes", "class=2;code=403;code=404;code=405")
modparam("dispatcher", "xavp_dst", "_dsdst_")

modparam("rr", "enable_full_lr", 1)
modparam("rr", "append_fromtag", 1)
modparam("tm", "fr_timer", DS_FR_TIMER)
modparam("tm", "fr_inv_timer", FR_INV_TIMER)
# Pass a 503 on as 503 (by default tm turns a final 503 into 500): when every node is full, carriers see the same
# 503 they get when no node is up, and reroute.
modparam("tm", "remap_503_500", 0)

modparam("jsonrpcs", "pretty_format", 1)
# HTTP only (via xhttp). The default leaves HTTP off, and jsonrpc_dispatch() then drops each request unanswered.
modparam("jsonrpcs", "transport", 1)

request_route {
	# Adds Max-Forwards: 70 when missing (RFC 3261's recommended value), decrements it otherwise.
	if (!mf_process_maxfwd_header("70")) {
		sl_send_reply("483", "Too Many Hops");
		exit;
	}
	# RFC 3261 8.2.2.1: a Request-URI scheme we don't support (anything but sip, sips and tel) gets 416. Matched on
	# the request line itself: a URI Kamailio can't parse has no $ru, and sanity would answer 400 Bad Request URI.
	if (!($(mb{line.at,0}) =~ "^[A-Za-z]+ +(sips?|tel):")) {
		sl_send_reply("416", "Unsupported URI Scheme");
		exit;
	}
	# 18407 adds the Proxy-Require check (512) to the module's default checks: a request requiring an extension
	# we don't support gets 420 (sanity's proxy_require list is empty).
	if (!sanity_check("18407", "7")) {
		exit;
	}

	# Requests inside a dialog follow its route set, draining or not.
	if (has_totag()) {
		if (loose_route()) {
			t_set_fr(FR_INV_TIMER, RELAY_FR_TIMER);
			route(RELAY);
		}
		if (is_method("ACK")) {
			if (t_check_trans()) {
				route(RELAY);
			}
			exit;  # an ACK is never answered
		}
		sl_send_reply("481", "Call/Transaction Does Not Exist");
		exit;
	}

	# A CANCEL follows its INVITE to the node that has it. One that matches nothing is answered, not forwarded:
	# without the INVITE there is no node to send it to.
	if (is_method("CANCEL")) {
		if (t_check_trans()) {
			route(RELAY);
		}
		sl_send_reply("481", "Call/Transaction Does Not Exist");
		exit;
	}
	if (t_precheck_trans()) {
		t_check_trans();
		exit;
	}
	t_check_trans();

	# Keepalives: OPTIONS with no user part, from anyone but our own nodes (theirs go on to the peer they ping).
	# Matched on the missing user rather than on our address, which a peer may write as a name or an address
	# Kamailio doesn't know as its own. While draining, or while no node is active, the answer is 503, so peers
	# route elsewhere.
	if (is_method("OPTIONS") && $rU == $null && !ds_is_from_list()) {
		if ($shv(draining) == 1 || !route(ANY_ACTIVE)) {
			sl_send_reply("503", "No FreeSWITCH Available");
			exit;
		}
		append_to_reply("Allow: INVITE, ACK, BYE, CANCEL, OPTIONS, INFO, UPDATE, REFER, NOTIFY\r\n");
		sl_send_reply("200", "OK");
		exit;
	}

	remove_hf("Route");
	record_route();

	# From a FreeSWITCH node toward a peer: relay to the request URI, from our fixed address. A draining Kamailio
	# still relays these: they belong to calls already up (a transfer, say).
	if (ds_is_from_list()) {
		t_set_fr(FR_INV_TIMER, RELAY_FR_TIMER);
		route(RELAY);
	}

	if ($shv(draining) == 1) {
		sl_send_reply("503", "Draining");
		exit;
	}
{{- if .Sets}}

	# From a peer: the first set with an active node, round-robin within it, failing over on 503 or no answer to
	# the set's next node and then to the next set's.
	if (!ds_select_routes("{{.Rules}}", "0")) {
		sl_send_reply("503", "No FreeSWITCH Available");
		exit;
	}
	t_set_fr(FR_INV_TIMER, DS_FR_TIMER);
	t_on_failure("DS_FAILOVER");
	route(RELAY);
{{- else}}

	# No FreeSWITCH fleet to send calls to (spec.dispatch is empty).
	sl_send_reply("503", "No FreeSWITCH Available");
	exit;
{{- end}}
}

# Whether any set has an active node.
route[ANY_ACTIVE] {
{{- range .Sets}}
	if (ds_is_active("{{.}}")) {
		return 1;
	}
{{- end}}
	return -1;
}

route[RELAY] {
	if (!t_relay()) {
		sl_reply_error();
	}
	exit;
}

# A paused (draining) FreeSWITCH answers new calls with 503; a dead one doesn't answer. Either way, try the next.
failure_route[DS_FAILOVER] {
	if (t_is_canceled()) {
		exit;
	}
	if (t_check_status("503") || (t_branch_timeout() && !t_branch_replied())) {
		ds_mark_dst("ip");
		if (ds_next_dst()) {
			t_on_failure("DS_FAILOVER");
			route(RELAY);
		}
	}
}

# JSON-RPC, only on the RPC port and only with the pod's token. A pod without a token refuses everything.
event_route[xhttp:request] {
	if ($Rp != RPC_PORT) {
		xhttp_reply("403", "Forbidden", "text/plain", "forbidden\n");
		exit;
	}
	$var(bearer) = "Bearer " + $env(KAMAILIO_RPC_TOKEN);
	if ($env(KAMAILIO_RPC_TOKEN) == $null || $env(KAMAILIO_RPC_TOKEN) == "" || $hdr(Authorization) != $var(bearer)) {
		xhttp_reply("401", "Unauthorized", "text/plain", "unauthorized\n");
		exit;
	}
	if ($hu =~ "^/RPC") {
		jsonrpc_dispatch();
		exit;
	}
	xhttp_reply("404", "Not Found", "text/plain", "not found\n");
}
