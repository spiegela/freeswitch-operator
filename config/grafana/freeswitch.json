     "expr": "max by (pod) (freeswitch_sessions_limit{job=\"freeswitch\", namespace=~\"$namespace\", fleet=~\"$fleet\", pod=~\"$pod\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
