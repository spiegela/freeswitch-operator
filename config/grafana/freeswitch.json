     },
     "refId": "E",
     "expr": "max by (pod) (freeswitch_sessions_peak{job=\"freeswitch\", namespace=~\"$namespace\", fleet=~\"$fleet\", pod=~\"$pod\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
