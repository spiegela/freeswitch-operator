      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "G",
     "expr": "max by (pod) (freeswitch_session_rate_limit{job=\"freeswitch\", namespace=~\"$namespace\", fleet=~\"$fleet\", pod=~\"$pod\"})",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
