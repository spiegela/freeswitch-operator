<include>
  <!--
    Calls arriving from far ends. Every call is bridged to the backend with its X- headers (FreeSWITCH copies
    custom headers to the bridged leg by default). If the backend rejects the call, doesn't answer within
    ring_timeout, or can't be reached, the caller gets the fallback: the call is answered with a response
    header X-Fallback-Reason (FreeSWITCH's originate disposition, e.g. USER_BUSY, NO_ANSWER, CALL_REJECTED),
    hears a tone of fallback_tone_hz for fallback_tone_ms, and is hung up. A real edge replaces the tone with
    a configured fallback number or announcement.
  -->
  <context name="trunks">
    <extension name="backend-target" continue="true">
      <condition field="destination_number" expression="^.+$">
        <action application="set" data="bench_target_host=$${backend_host}" inline="true"/>
        <action application="set" data="bench_target_user=${destination_number}" inline="true"/>
      </condition>
    </extension>

    <!--
      A called number starting with "lk" goes to LiveKit SIP (livekit_host) without the prefix, so an agent can take
      the call while every other number stays on the backend. Without LIVEKIT_HOST it is the backend too.
    -->
    <extension name="livekit-target" continue="true">
      <condition field="destination_number" expression="^lk(.+)$">
        <action application="set" data="bench_target_host=$${livekit_host}" inline="true"/>
        <action application="set" data="bench_target_user=$1" inline="true"/>
      </condition>
    </extension>

    <!--
      A caller ID name with a double quote in it (sent escaped, as in "John \"JJ\" Smith") reaches the dialplan
      unescaped, and FreeSWITCH 1.10 can't then build the From header of its leg to the backend: the bridge fails
      with DESTINATION_OUT_OF_ORDER ("Error creating HANDLE!" in the log) and the call never gets there. Swap
      double quotes for single ones before bridging. Any edge dialplan that bridges a caller's name onward needs
      the same.
    -->
    <extension name="caller-name-quotes" continue="true">
      <condition field="caller_id_name" expression="&quot;">
        <action application="set" data="effective_caller_id_name=${replace(${caller_id_name}|&quot;|')}" inline="true"/>
      </condition>
    </extension>

    <!-- Bench only: a backend address that never answers. -->
    <extension name="bench-unreachable" continue="true">
      <condition field="destination_number" expression="^unreachable$">
        <action application="set" data="bench_target_host=$${unreachable_host}" inline="true"/>
      </condition>
    </extension>

    <!--
      Barge-in voice detection (vars.xml, barge_in_vad): the fleet's mode, or the caller's X-Barge-In-VAD header
      (livekit | freeswitch). The backend gets the mode in force in the same header, so the agent knows whether to
      run its own detector or listen for the edge's. The detector (barge_in_vad_engine) likewise: the fleet's, or the
      caller's X-Barge-In-VAD-Engine (silero | webrtc).
    -->
    <extension name="barge-in-mode" continue="true">
      <condition field="destination_number" expression="^.+$">
        <action application="set" data="barge_in_vad=$${barge_in_vad}" inline="true"/>
        <!-- As channel variables, so conditions can test them: a condition's field names a variable, and a value
             pre-processed into it ($${...}) would be read as a variable's name. -->
        <action application="set" data="barge_in_vad_engine=$${barge_in_vad_engine}" inline="true"/>
        <action application="set" data="barge_in_echo_cancel=$${barge_in_echo_cancel}" inline="true"/>
      </condition>
    </extension>
    <extension name="barge-in-mode-from-caller" continue="true">
      <condition field="${sip_h_X-Barge-In-VAD}" expression="^(livekit|freeswitch)$">
        <action application="set" data="barge_in_vad=$1" inline="true"/>
      </condition>
    </extension>
    <extension name="barge-in-engine-from-caller" continue="true">
      <condition field="${sip_h_X-Barge-In-VAD-Engine}" expression="^(silero|webrtc)$">
        <action application="set" data="barge_in_vad_engine=$1" inline="true"/>
      </condition>
    </extension>
    <extension name="barge-in-mode-to-backend" continue="true">
      <condition field="destination_number" expression="^.+$">
        <action application="set" data="sip_h_X-Barge-In-VAD=${barge_in_vad}" inline="true"/>
      </condition>
    </extension>

    <!--
      With "freeswitch", once the call is answered: echo cancellation on what the caller sends (unless
      barge_in_echo_cancel is 0), then a detector on it (media bug "caller"), and a second detector on what the agent
      sends, the backend leg's own audio (detector "agent"), so a consumer can set a higher bar for caller speech
      while we are talking. Each detector reads its leg's incoming audio only. The detectors are mod_speech_detect's
      (images/freeswitch/mod_speech_detect at the repository root); on each change they fire CUSTOM
      speech_detect::change: Speech-Event started or stopped, Speech-Detector caller or agent, Speech-Engine,
      Speech-At (when, in Unix ms) and, from silero, Speech-Probability.
    -->
    <extension name="barge-in-engine-silero" continue="true">
      <condition field="${barge_in_vad}" expression="^freeswitch$"/>
      <condition field="${barge_in_vad_engine}" expression="^silero$">
        <!-- a start takes 250 ms of windows scoring 0.5 or more; a stop, 100 ms scoring under 0.35 -->
        <action application="set" data="barge_in_detector=silero threshold=0.5 min_speech_ms=250 min_silence_ms=100" inline="true"/>
      </condition>
    </extension>
    <extension name="barge-in-engine-webrtc" continue="true">
      <condition field="${barge_in_vad}" expression="^freeswitch$"/>
      <condition field="${barge_in_vad_engine}" expression="^webrtc$">
        <!-- mode 3 (the strictest about what counts as voice), 100 ms of voice to start, 300 ms of silence to stop -->
        <action application="set" data="barge_in_detector=webrtc mode=3 voice_ms=100 silence_ms=300" inline="true"/>
      </condition>
    </extension>
    <extension name="barge-in-echo-cancel" continue="true">
      <condition field="${barge_in_detector}" expression="^.+$"/>
      <condition field="${barge_in_echo_cancel}" expression="^[1-9][0-9]*$">
        <action application="set" data="api_on_answer_1=uuid_preprocess ${uuid} r.echo_cancel=${barge_in_echo_cancel}" inline="true"/>
      </condition>
    </extension>
    <extension name="barge-in-detect" continue="true">
      <condition field="${barge_in_detector}" expression="^.+$">
        <action application="set" data="api_on_answer_2=uuid_speech_detect ${uuid} start caller ${barge_in_detector}" inline="true"/>
        <!-- The backend leg's detector starts when that leg answers; its uuid is chosen here so the command can name it,
             and so the exporter's relay can find the leg to send this call's detections on as SIP INFO. FreeSWITCH
             sends an INFO only to a far end that says it takes them (X-FS-Support: send_info), which no agent does,
             unless the leg sets fs_send_unsupported_info. -->
        <action application="set" data="barge_in_agent_uuid=${create_uuid()}" inline="true"/>
        <action application="set" data="barge_in_leg_vars=,origination_uuid=${barge_in_agent_uuid},fs_send_unsupported_info=true,api_on_answer=uuid_speech_detect ${barge_in_agent_uuid} start agent ${barge_in_detector}" inline="true"/>
      </condition>
    </extension>

    <extension name="to-backend">
      <condition field="destination_number" expression="^(.+)$">
        <!-- Exported, so the backend leg and any transfer leg time out too. -->
        <action application="export" data="media_timeout=$${media_timeout_ms}"/>
        <action application="export" data="media_hold_timeout=$${media_hold_timeout_ms}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=true"/>
        <action application="set" data="call_timeout=$${ring_timeout}"/>
        <action application="set" data="inherit_codec=true"/>
        <!-- A REFER from the backend transfers this caller through the transfers context. -->
        <action application="set" data="force_transfer_context=transfers"/>
        <action application="set" data="force_transfer_dialplan=XML"/>
        <action application="bridge" data="{force_transfer_context=transfers,force_transfer_dialplan=XML${barge_in_leg_vars}}sofia/backend/${bench_target_user}@${bench_target_host}"/>
        <!-- Reached only when the bridge failed: the fallback, which needs no barge-in detection. -->
        <action application="unset" data="api_on_answer_1"/>
        <action application="unset" data="api_on_answer_2"/>
        <action application="set" data="sip_rh_X-Fallback-Reason=${originate_disposition}"/>
        <action application="answer"/>
        <action application="playback" data="tone_stream://%($${fallback_tone_ms},0,$${fallback_tone_hz})"/>
        <action application="hangup" data="NORMAL_CLEARING"/>
      </condition>
    </extension>
  </context>
</include>
