<include>
  <!--
    Variables are read from the environment at start through the exec-set pre-processor, so the same files
    run on a laptop, in compose and on a cluster. Defaults suit the compose bench. See bin/env.sh.
  -->

  <!-- The address peers see for RTP (ext-rtp-ip). On a cluster freeswitch-operator writes it to the
       downward-API file /etc/freeswitch-operator/podinfo/external-address; without it, this host's address. -->
  <X-PRE-PROCESS cmd="exec-set" data="external_address=/bin/sh /usr/local/freeswitch/conf/bin/podinfo.sh external-address"/>

  <!-- The address RTP is bound to (rtp-ip): FreeSWITCH's own, unless the pod's address pool gives it one of its own
       on the node, which freeswitch-operator writes to /etc/freeswitch-operator/podinfo/bind-address. SIP stays on
       local_ip_v4, where Kamailio dispatches to it. -->
  <X-PRE-PROCESS cmd="exec-set" data="bind_address=/bin/sh /usr/local/freeswitch/conf/bin/podinfo.sh bind-address $${local_ip_v4}"/>

  <!-- Where calls from trunks go: the mock backend in the bench (but see livekit_host). host[:port] -->
  <X-PRE-PROCESS cmd="exec-set" data="backend_host=/bin/sh /usr/local/freeswitch/conf/bin/env.sh BACKEND_HOST mockbackend:5060"/>
  <!-- Where calls to "lk<number>" go: LiveKit SIP, where an agent answers. The backend when unset. host[:port] -->
  <X-PRE-PROCESS cmd="exec-set" data="livekit_host=/bin/sh /usr/local/freeswitch/conf/bin/env.sh LIVEKIT_HOST $${backend_host}"/>
  <!-- Where transfers asked for by the backend (REFER) are placed. host[:port] -->
  <X-PRE-PROCESS cmd="exec-set" data="transfer_host=/bin/sh /usr/local/freeswitch/conf/bin/env.sh TRANSFER_HOST sipbench:5090"/>
  <!-- An address that never answers, for the unreachable-backend scenario (TEST-NET-1). Bench only. -->
  <X-PRE-PROCESS cmd="exec-set" data="unreachable_host=/bin/sh /usr/local/freeswitch/conf/bin/env.sh UNREACHABLE_HOST 192.0.2.1:5060"/>
  <!-- Seconds the backend may ring before the caller gets the fallback. -->
  <X-PRE-PROCESS cmd="exec-set" data="ring_timeout=/bin/sh /usr/local/freeswitch/conf/bin/env.sh RING_TIMEOUT 6"/>
  <!-- Hang up a call whose RTP stops (a lost BYE, a dead link, a crashed far end or backend) instead of keeping
       it, and its backend leg, up forever: milliseconds without RTP, and the same while the call is on hold. -->
  <X-PRE-PROCESS cmd="exec-set" data="media_timeout_ms=/bin/sh /usr/local/freeswitch/conf/bin/env.sh MEDIA_TIMEOUT_MS 60000"/>
  <X-PRE-PROCESS cmd="exec-set" data="media_hold_timeout_ms=/bin/sh /usr/local/freeswitch/conf/bin/env.sh MEDIA_HOLD_TIMEOUT_MS 1800000"/>
  <!-- The fallback a caller hears when the backend can't take the call: a tone, then hang up. -->
  <X-PRE-PROCESS cmd="exec-set" data="fallback_tone_hz=/bin/sh /usr/local/freeswitch/conf/bin/env.sh FALLBACK_TONE_HZ 1400"/>
  <X-PRE-PROCESS cmd="exec-set" data="fallback_tone_ms=/bin/sh /usr/local/freeswitch/conf/bin/env.sh FALLBACK_TONE_MS 3000"/>

  <!-- Barge-in voice detection: who decides the caller is talking over the agent. "livekit" (the default) leaves it to
       the agent behind LiveKit SIP, and the edge only says so (X-Barge-In-VAD on the backend leg). "freeswitch" has
       the edge cancel echo and run a voice detector on what the caller sends, and another on what the agent sends
       (so a consumer knows when we are talking), firing events on the event socket. A call's X-Barge-In-VAD header
       overrides it. See dialplan/trunks.xml and "Voice detection for barge-in" in the top-level README. -->
  <X-PRE-PROCESS cmd="exec-set" data="barge_in_vad=/bin/sh /usr/local/freeswitch/conf/bin/env.sh BARGE_IN_VAD livekit"/>
  <!-- The detector with "freeswitch": silero (mod_vad_silero, a neural model; events carry a probability) or webrtc
       (mod_vad_detect, FreeSWITCH's libfvad VAD; start and stop events only). -->
  <X-PRE-PROCESS cmd="exec-set" data="barge_in_vad_engine=/bin/sh /usr/local/freeswitch/conf/bin/env.sh BARGE_IN_VAD_ENGINE silero"/>
  <!-- Echo cancellation on what the caller sends, with "freeswitch": preprocess's r.echo_cancel value (speexdsp's
       tail), 0 for none. -->
  <X-PRE-PROCESS cmd="exec-set" data="barge_in_echo_cancel=/bin/sh /usr/local/freeswitch/conf/bin/env.sh BARGE_IN_ECHO_CANCEL 1024"/>

  <!-- Where the event socket listens. The bench's runner uses it for admission tests; on a cluster keep it on
       127.0.0.1, where fs_cli (and the operator's ready and drain scripts) reach it. -->
  <X-PRE-PROCESS cmd="exec-set" data="esl_listen_ip=/bin/sh /usr/local/freeswitch/conf/bin/env.sh ESL_LISTEN_IP 0.0.0.0"/>

  <X-PRE-PROCESS cmd="set" data="domain=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="console_loglevel=info"/>
</include>
