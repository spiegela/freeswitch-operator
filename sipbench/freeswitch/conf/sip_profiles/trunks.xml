<!--
  trunks: the profile far ends reach (carriers, PBXs), and the one Kamailio dispatches to on a cluster.
  The external address is what peers see for media; see bin/podinfo.sh.
  It runs as trunks-<external address> (vars.xml, bin/profile-name.sh), so call recovery takes one address's calls
  at a time; "trunks" is its alias, which dial strings and commands use.
-->
<profile name="$${trunks_profile}">
  <aliases>
    <alias name="trunks"/>
  </aliases>
  <gateways/>
  <domains/>
  <settings>
    <param name="context" value="trunks"/>
    <param name="dialplan" value="XML"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${bind_address}"/>
    <!--
      SIP advertises its own address, where it listens: peers signal only through Kamailio, which record-routes and
      reaches it there. The external address may reach only RTP's bind address, or reach the node only through the
      cloud's translation, and a Contact naming it would send the dialog's ACK and BYE the long way, or nowhere.
    -->
    <param name="ext-sip-ip" value="$${local_ip_v4}"/>
    <param name="ext-rtp-ip" value="$${external_address}"/>
    <!--
      FreeSWITCH uses ext-sip-ip and ext-rtp-ip only for peers outside local-network-acl, and every call here comes
      through Kamailio, on a private address. With the default (localnet.auto) it offered carriers rtp-ip, its
      private address (on AWS, a pool's secondary private address), and their media never arrived. Nothing is local,
      so every caller gets the external address. Where rtp-ip already is that address (a Local pool such as MetalLB;
      compose, where it is the container's own) nothing changes. Behind a NAT, callers inside the cluster (sipbench)
      reach it through the cloud's translation, so the node's security group must let them in.
    -->
    <param name="local-network-acl" value="nowhere"/>
    <param name="sip-port" value="5060"/>
    <!-- A real edge lists each trunk's addresses in an ACL; the bench allows its own network. -->
    <param name="apply-inbound-acl" value="bench"/>
    <param name="auth-calls" value="false"/>
    <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
    <param name="outbound-codec-prefs" value="$${outbound_codec_prefs}"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="dtmf-type" value="rfc2833"/>
    <param name="rfc2833-pt" value="101"/>
    <param name="liberal-dtmf" value="true"/>
    <param name="rtp-timer-name" value="soft"/>
    <param name="manage-presence" value="false"/>
    <param name="inbound-late-negotiation" value="false"/>
    <param name="enable-timer" value="false"/>
    <!-- Answer OPTIONS with 503 when this node is paused or full, so Kamailio's dispatcher probe sees it. -->
    <param name="sip-options-respond-503-on-busy" value="true"/>
    <param name="user-agent-string" value="sipbench-edge"/>
    <!-- vars.xml. Both profiles track: a recovered call needs both of its legs. -->
    <param name="track-calls" value="$${track_calls}"/>
    <!-- vars.xml: HEP copies of this profile's SIP, for per-call traces. -->
    <param name="sip-capture" value="$${sip_capture}"/>
  </settings>
</profile>
